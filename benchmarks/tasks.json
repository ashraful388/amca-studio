        },
        {
          "criterion_id": "exact_expectation",
          "kind": "json_path_exact",
          "path": "$.exact_fraction",
          "expected": "33/4",
          "required": true,
          "weight": 15
        },
        {
          "criterion_id": "automaton",
          "kind": "transition_map_equivalent",
          "path": "$.transitions",
          "expected_reference_path": "$.reference.transitions",
          "required": true,
          "weight": 25
        },
        {
          "criterion_id": "equation_derivation",
          "kind": "rubric_predicate",
          "path": "$.state_equations",
