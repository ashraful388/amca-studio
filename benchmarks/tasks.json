      "task_id": "math-crt-001",
      "version": 1,
      "domain": "mathematics",
      "title": "Four-modulus reconstruction",
      "difficulty": "hard",
      "prompt": "Find the least nonnegative integer n satisfying all four congruences: n mod 7 = 2, n mod 11 = 3, n mod 13 = 5, and n mod 17 = 7. Prove that your answer is unique modulo the product of the moduli. Return a structured answer containing answer, modulus, residue_verification, and proof_summary.",
      "allowed_tools": [
        "calculator",
        "python",
        "sympy"
      ],
      "response_contract": {
        "type": "object",
        "required": [
          "answer",
          "modulus",
          "residue_verification",
          "proof_summary"
        ]
      },
      "reference": {
        "answer": 13148,
        "modulus": 17017,
        "residues": {
          "7": 2,
          "11": 3,
          "13": 5,
          "17": 7
        }
      },
      "criteria": [
        {
          "criterion_id": "answer",
          "kind": "json_path_exact",
          "path": "$.answer",
          "expected": 13148,
          "required": true,
          "weight": 30
        },
        {
          "criterion_id": "modulus",
          "kind": "json_path_exact",
          "path": "$.modulus",
          "expected": 17017,
          "required": true,
          "weight": 20
        },
        {
          "criterion_id": "residue_check",
          "kind": "residue_vector",
          "value_path": "$.answer",
          "expected": [
            {
              "modulus": 7,
              "residue": 2
            },
            {
              "modulus": 11,
              "residue": 3
            },
            {
              "modulus": 13,
              "residue": 5
            },
            {
              "modulus": 17,
              "residue": 7
            }
          ],
          "required": true,
          "weight": 20
        },
        {
          "criterion_id": "uniqueness_proof",
          "kind": "rubric_predicate",
          "path": "$.proof_summary",
          "must_establish": [
            "the four moduli are pairwise coprime",
            "the Chinese Remainder Theorem applies",
            "all solutions are congruent modulo 17017"
          ],
          "required": true,
          "weight": 30
        }
      ],
      "tags": [
        "exact",
        "proof",
        "verification"
      ]
    },
