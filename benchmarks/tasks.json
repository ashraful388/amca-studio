          "transitions",
          "state_equations",
          "conclusion"
        ]
      },
      "reference": {
        "expected_tosses": 8.25,
        "exact_fraction": "33/4",
        "states": [
          "empty",
          "H",
          "HT",
          "done"
        ],
        "transitions": {
          "empty": {
            "H": "H",
            "T": "empty"
          },
          "H": {
            "H": "H",
            "T": "HT"
